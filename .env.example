NODE_ENV=development
PORT=8788

# Server-to-server callers: id:secret,id:secret
# Browser clients never receive these secrets.
DIGI_AI_CALLERS=mybrandos:change-me,digi-ai:change-me,test:test-secret

# Trust ID remains the identity authority. Digi AI does not store users.
TRUSTID_API=http://localhost:8787

# Public canonical read adapters. Digi AI does not copy these stores.
DIGIPEDIA_URL=https://digiconomy-digipedia-production.up.railway.app
DIGINEWS_URL=https://digiconomy-news-production.up.railway.app
FETCH_TIMEOUT_MS=8000

# Provider layer. Digi AI is not the provider.
AI_PROVIDER=unbound
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
PROVIDER_TIMEOUT_MS=20000

# Optional durable JSONL directory for usage/receipts. Never stores API keys.
DATA_DIR=

# Development-only: allow the "test" caller to attest an actor after caller auth.
DIGI_AI_ALLOW_ATTESTED_ACTOR=false

# Credit economy enforcement: disabled | observe | enforce
# Production must stay observe or disabled until commercial grants exist.
DIGI_AI_ECONOMICS_MODE=observe
